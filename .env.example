# Copy to .env and change the values. .env is NEVER committed.
# Generate a secret (PowerShell):
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_SECRET=replace-me-with-a-random-string-of-at-least-32-bytes
WEBHOOK_SECRET=replace-me-with-another-random-string-of-32-bytes-or-more
ADMIN_PASSWORD=replace-me-with-a-strong-admin-password